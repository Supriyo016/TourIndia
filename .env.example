# Copy to .env.local for development. Never commit real values.

# Public address of the deployed site. Used for canonical URLs, the sitemap and
# the same-origin check on form submissions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string, for a least-privilege user limited to this database.
# Without it the site still works; forms report that submissions are unavailable.
MONGODB_URI=
MONGODB_DB=tour_india

# Random secret of at least 32 characters. Used to hash visitor IP addresses for
# rate limiting, so raw addresses are never stored. Required in production when
# MONGODB_URI is set; forms refuse submissions without it.
RATE_LIMIT_SALT=

# Only when self-hosting behind reverse proxies (not needed on Vercel): how many
# trusted proxies sit in front of the app. Without it, all visitors share one
# rate-limit bucket.
# TRUSTED_PROXY_HOPS=1
