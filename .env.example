# Copy to .env.local for development. Never commit real values.

# Public address of the deployed site. Used for canonical URLs, the sitemap and
# the same-origin check on form submissions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string, for a least-privilege user limited to this database.
# Without it the site still works; forms report that submissions are unavailable.
MONGODB_URI=
MONGODB_DB=tour_india

# Random secret of at least 32 characters. Used to hash visitor IP addresses for
# rate limiting, so raw addresses are never stored. Required in production when
# MONGODB_URI is set; forms refuse submissions without it.
RATE_LIMIT_SALT=

# Connects Yatri to Claude. Without it Yatri still answers from the site's guides.
# Set a monthly spend limit in the Anthropic Console before adding this.
ANTHROPIC_API_KEY=
# Optional. Defaults shown: claude-opus-5-5, and 500 AI replies a day across the site.
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=500

# Random secret of at least 16 characters for signing session cookies.
# Falls back to RATE_LIMIT_SALT.
# COOKIE_SECRET=

# Only when self-hosting behind reverse proxies (not needed on Vercel): how many
# trusted proxies sit in front of the app. Without it, all visitors share one
# rate-limit bucket.
# TRUSTED_PROXY_HOPS=1

# Accounts (sign-in with an emailed 6-digit code, and Google)
# AUTH_SECRET signs codes and sign-in state. At least 32 random characters. Required in production.
AUTH_SECRET=
# Sends the codes. Create a free account at resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM="Tour India <no-reply@your-domain.example>"
# "Continue with Google": create an OAuth client (Web application) in Google Cloud Console.
# Authorised redirect URI: https://<your-site>/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated addresses allowed to sign in at /admin/login.
ADMIN_EMAILS=

# Google Search Console: the code from the HTML-tag verification method (content="...").
GOOGLE_SITE_VERIFICATION=

# Google Maps (public: restrict the key to your domains in Google Cloud).
# Without a key, place maps use Google's keyless embed and the India map uses the drawn map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# A vector Map ID with the "Administrative area level 1" feature layer turned on (state shading).
NEXT_PUBLIC_GOOGLE_MAP_ID=
