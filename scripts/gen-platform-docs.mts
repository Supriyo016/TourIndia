/**
 * Regenerates docs/PERMISSIONS.md and docs/ROUTES.md from the code, so the reference can't drift.
 * Usage: npx tsx scripts/gen-platform-docs.mts
 */
import { readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { BUILT_IN_ROLES, PERMISSIONS, type Permission } from "../src/features/admin/permissions.ts";

const files = (dir: string, name: string): string[] =>
  readdirSync(dir).flatMap((entry) => {
    const full = join(dir, entry);
    return statSync(full).isDirectory() ? files(full, name) : entry === name ? [full.replace(/\\/g, "/")] : [];
  });

// Which permission each admin page and route checks, read from requireAdminPage / requireAdminApi calls.
const checks = (file: string) => [...readFileSync(file, "utf8").matchAll(/requireAdmin(?:Page|Api)\([^)]*?"([a-z]+\.[a-z]+)"/g)].map((m) => m[1] as Permission);
const fresh = (file: string) => /fresh:\s*true/.test(readFileSync(file, "utf8"));

const pages = files("src/app/admin", "page.tsx").map((file) => ({
  path: file.replace(/^src\/app/, "").replace(/\/page\.tsx$/, "") || "/",
  needs: checks(file),
  guarded: /requireAdminPage\(/.test(readFileSync(file, "utf8")),
  selfChecked: /currentSession\(/.test(readFileSync(file, "utf8")),
}));
const routes = files("src/app/api", "route.ts").map((file) => {
  const text = readFileSync(file, "utf8");
  return {
    path: file.replace(/^src\/app/, "").replace(/\/route\.ts$/, ""),
    methods: ["GET", "POST", "PUT", "PATCH", "DELETE"].filter((m) => new RegExp(`export (async )?function ${m}\\b|export const ${m}\\b`).test(text)),
    needs: checks(file),
    fresh: fresh(file),
    signedIn: /sessionFromRequest|currentSession/.test(text),
    // Admin routes that pick the permission per action pass a variable rather than a literal.
    perAction: /requireAdminApi\(request,\s*[A-Z_a-z]+\[/.test(text),
    limit: /readJson\(|guardJsonPost\(|isAllowed\(|createFormHandler\(|readUpload\(/.test(text),
    // The MFA route checks the admin session itself, before an authenticator is set up.
    adminSelf: /mfaState|accessFor\(/.test(text),
  };
});

const perms = Object.keys(PERMISSIONS) as Permission[];
const lines = [
  "# Permissions",
  "",
  "Generated by `npx tsx scripts/gen-platform-docs.mts` from `src/features/admin/permissions.ts` and the admin pages and routes. Every admin page and API checks its permission on the server; the menu only hides what a role can't use. Every admin also needs an authenticator code at sign-in, and actions marked *fresh* ask for one again if the last was over 15 minutes ago. `ADMIN_EMAILS` are always Super Admins.",
  "",
  "## Built-in roles",
  "",
  `| Permission | ${BUILT_IN_ROLES.map((r) => r.name).join(" | ")} |`,
  `|---|${BUILT_IN_ROLES.map(() => ":-:").join("|")}|`,
  ...perms.map((p) => `| \`${p}\`: ${PERMISSIONS[p]} | ${BUILT_IN_ROLES.map((r) => (r.permissions.includes(p) ? "✓" : "")).join(" | ")} |`),
  "",
  "## Admin pages",
  "",
  "| Page | Needs |",
  "|---|---|",
  ...pages.sort((a, b) => a.path.localeCompare(b.path)).map((p) => `| \`${p.path}\` | ${p.needs.length ? p.needs.map((n) => `\`${n}\``).join(", ") : p.guarded ? "any admin" : p.selfChecked ? "any admin (checked in the page, before an authenticator is set up)" : "anyone (the admin sign-in page)"} |`),
  "",
];
writeFileSync("docs/PERMISSIONS.md", lines.join("\n"));

const routeLines = [
  "# API routes",
  "",
  "Generated by `npx tsx scripts/gen-platform-docs.mts`. Every POST takes JSON from the site's own origin, is rate-limited per address and validated with a schema (16 KB unless noted in the route). *Signed in* routes answer 401 without a session; admin routes answer 401/403 without the permission, and 401 `reauth` when a fresh code is needed. Other people's records answer 404. See [api.md](api.md) for the public form routes and response codes, and [PERMISSIONS.md](PERMISSIONS.md) for roles.",
  "",
  "| Route | Methods | Who | Fresh code | Rate-limited |",
  "|---|---|---|:-:|:-:|",
  ...routes
    .sort((a, b) => a.path.localeCompare(b.path))
    .map((r) => `| \`${r.path}\` | ${r.methods.join(", ")} | ${r.needs.length ? [...new Set(r.needs)].map((n) => `\`${n}\``).join(", ") : r.perAction ? "admin, permission per action" : r.adminSelf ? "any admin (checked in the route)" : r.path.startsWith("/api/cron") ? "cron secret" : r.signedIn ? "signed in (some actions public)" : "public"} | ${r.fresh ? "✓" : ""} | ${r.limit ? "✓" : ""} |`),
  "",
];
writeFileSync("docs/ROUTES.md", routeLines.join("\n"));
console.log(`docs: ${pages.length} admin pages, ${routes.length} routes`);
